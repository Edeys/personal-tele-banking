# ─────────────────────────────────────────────────────────────
# Tele-Banking — copy file này thành .env rồi điền.
# Secrets CHỈ nằm ở .env. Cấu hình danh mục/tài khoản do wizard
# trong bot tạo, lưu ở data/config.json (đừng sửa tay file .env này).
# ─────────────────────────────────────────────────────────────

# ── Telegram (bắt buộc) ──────────────────────────────────────
# Lấy từ @BotFather → /newbot → copy token
TELE_BOT_TOKEN=

# ── LLM vision + chat (bắt buộc) ─────────────────────────────
# Bất kỳ endpoint OpenAI-compatible nào: OpenRouter, OpenAI, Groq,
# Ollama/vLLM local, 9Router...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Model đọc ảnh (vision). Phải hỗ trợ image input.
LLM_OCR_MODEL=qwen/qwen2.5-vl-72b-instruct
# Model chat trợ lý tài chính
LLM_CHAT_MODEL=openai/gpt-4o-mini

# ── Google Sheets backend (mặc định, xem docs/setup-sheets.md) ─
# URL Web App sau khi Deploy Apps Script + secret tự đặt trong script
SHEETS_WEBAPP_URL=
SHEETS_WEBAPP_SECRET=

# ── Lưu ảnh biên lai (tuỳ chọn) ──────────────────────────────
# Thứ tự thử, mặc định: catbox,telegraph,local
# Thêm drive/webdav nếu cấu hình bên dưới
IMAGE_STORE=catbox,telegraph,local
# WebDAV (NAS/Nextcloud tự host)
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASS=
WEBDAV_FOLDER=tele-banking

# ── Lark Base backend (tuỳ chọn, xem docs/setup-lark.md) ─────
LARK_APP_ID=
LARK_APP_SECRET=
LARK_APP_TOKEN=
LARK_TABLE_ID=

# ── Khác ─────────────────────────────────────────────────────
# Đường dẫn config do wizard tạo (mặc định data/config.json)
# TELE_CONFIG_PATH=data/config.json
# Múi giờ dùng cho báo cáo (mặc định Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh
